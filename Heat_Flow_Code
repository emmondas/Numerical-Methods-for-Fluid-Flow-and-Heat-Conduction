    if i == 1
        h_FDD = r(i+1)-r(i);
        shear(i,1) = Dyn_visc * ((Velocity_10(i+1)-Velocity_10(i))/(r(i+1)-r(i)));
    elseif i ~= 1 && i ~= length(r)
        h_CDD = r(i+1) - r(i-1);
        shear(i,1) = Dyn_visc * ((Velocity_10(i+1)-Velocity_10(i-1))/(h_CDD));
    elseif i == length(r)
        h_BDD = r(i) - r(i-1);
        shear(i,1) = Dyn_visc * ((Velocity_10(i)-Velocity_10(i-1))/h_BDD);
    end
end

