%% Chapter 3
%% Part 1

V_find = input('Enter Velocity to be found = ');
r_low = 0;
r_high = input('Enter Initial High Guess = ');
r_values = [];

V_low = delta_p * ((R^2)/(4*Dyn_visc*Length)) * (1-((r_low^2)/(R^2))) - V_find;  % Subtracting V_find to make it equal to zero
V_high = delta_p * ((R^2)/(4*Dyn_visc*Length)) * (1-((r_high^2)/(R^2))) - V_find;    % Subtracting V_find to make it equal to zero

if V_low * V_high > 0
    error('No root exists in the given range. Change your initial guess.');
end

Prev_appx = 0;
abs_Rel_appx = 500; 
n = [];
N = 0;
V_disp = [];

while abs_Rel_appx > 0.00005
    N = N +1;
    n = [n; N];
    r_mean = (r_low + r_high) / 2;
    r_values = [r_values; r_mean];
    % Computing function value at midpoint
    V_mean = delta_p * ((R^2)/(4*Dyn_visc*Length)) * (1-((r_mean^2)/(R^2))) - V_find;    % Subtracting V_find to make it equal to zero
    V_disp = [V_disp; V_mean+V_find];
    Curr_appx = r_mean;
    if Prev_appx ~= 0
        abs_Rel_appx = abs((Curr_appx - Prev_appx) / Curr_appx) * 100;
    end
    Prev_appx = Curr_appx; % Update for next iteration
    if V_low * V_mean < 0
        r_high = r_mean;
        V_high = V_mean;
    else
        r_low = r_mean;
        V_low = V_mean;
    end
end
